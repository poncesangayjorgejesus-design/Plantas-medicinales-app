<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#287653</item>
        <item name="android:windowBackground">#F7F8F0</item>
        <item name="android:statusBarColor">#F7F8F0</item>
        <item name="android:navigationBarColor">#F7F8F0</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="TextBody">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="TextTitle" parent="TextBody">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextHeading" parent="TextBody">
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextMeta" parent="TextBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/green</item>
    </style>
    <style name="ActionButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:padding">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">9dp</item>
    </style>
    <style name="DangerButton" parent="ActionButton">
        <item name="android:background">@drawable/bg_danger</item>
    </style>
    <style name="SecondaryButton" parent="ActionButton">
        <item name="android:background">@drawable/bg_secondary</item>
        <item name="android:textColor">@color/green</item>
    </style>
    <style name="NavigationButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/nav_text</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
    </style>
    <style name="SearchInput">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">15dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
</resources>
