    <TextView android:id="@+id/plant_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/plant_name" style="@style/TextHeading"/>
    <TextView android:id="@+id/plant_scientific" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/scientific" style="@style/TextMeta"/>
