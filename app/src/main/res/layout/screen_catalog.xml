<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/catalog_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/catalog_title" style="@style/TextTitle"/>
    <EditText android:id="@+id/catalog_query" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/catalog_hint" android:singleLine="true" android:inputType="text" style="@style/SearchInput"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/catalog_rows"/>
</LinearLayout>
