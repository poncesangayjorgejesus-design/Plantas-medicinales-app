<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/settings_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings" style="@style/TextTitle"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginBottom="14dp" android:elevation="2dp">
        <TextView android:id="@+id/engine_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/engine" style="@style/TextHeading"/>
        <TextView android:id="@+id/engine_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/engine_help" style="@style/TextBody"/>
        <EditText android:id="@+id/api_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/api_key" android:singleLine="true" android:inputType="textPassword" android:importantForAutofill="no" style="@style/SearchInput"/>
        <Button android:id="@+id/save_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save_settings" style="@style/ActionButton"/>
    </LinearLayout>
    <Button android:id="@+id/clear_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clear_history" style="@style/DangerButton"/>
</LinearLayout>
