<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/paper">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/page" android:padding="20dp">
            <TextView android:id="@+id/brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/brand" style="@style/TextMeta"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/page_content"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@color/sage">
        <Button android:id="@+id/nav_scan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="@string/scan" style="@style/NavigationButton"/>
        <Button android:id="@+id/nav_catalog" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="@string/catalog" style="@style/NavigationButton"/>
        <Button android:id="@+id/nav_history" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="@string/history" style="@style/NavigationButton"/>
        <Button android:id="@+id/nav_settings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="@string/settings" style="@style/NavigationButton"/>
    </LinearLayout>
</LinearLayout>
