<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginBottom="14dp" android:elevation="2dp">
    <TextView android:id="@+id/chart_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chart_title" style="@style/TextHeading"/>
    <TextView android:id="@+id/chart_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/empty" style="@style/TextMeta"/>
    <TextView android:id="@+id/chart_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chart_empty" style="@style/TextBody"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/chart_rows"/>
</LinearLayout>
